meta {
  name: 09 - Prompts Get
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: inherit
}

headers {
  Mcp-Session-Id: {{mcpSessionId}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 8,
    "method": "prompts/get",
    "params": {
      "name": "review_reminders",
      "arguments": {
        "timeframe": "this week"
      }
    }
  }
}
